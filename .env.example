# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=appUser
DB_PASSWORD=appUser1
DB_DATABASE=JTK
DB_SSL=false
DB_POOL_MAX=5

# ── Mail (Brevo / any SMTP) ───────────────────────────────────
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your-brevo-login@smtp-brevo.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# ── JWT Secrets (change these in production!) ─────────────────
ACCESS_TOKEN_PRIVATE_KEY=change_me_access
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_PRIVATE_KEY=change_me_refresh
REFRESH_TOKEN_EXPIRES_IN=30d
RESET_TOKEN_PRIVATE_KEY=change_me_reset
RESET_TOKEN_EXPIRES_IN=1h
VERIFY_TOKEN_PRIVATE_KEY=change_me_verify
VERIFY_TOKEN_EXPIRES_IN=1d

# ── App ───────────────────────────────────────────────────────
BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

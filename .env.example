# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=your_database_name
DB_SSL=false
DB_POOL_MAX=5
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your_brevo_smtp_user
MAIL_PASSWORD=your_brevo_api_key
MAIL_DEFAULT_SENDER=your_sender_email@example.com
ACCESS_TOKEN_PRIVATE_KEY=your_strong_random_32char_hex_secret
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_PRIVATE_KEY=your_strong_random_32char_hex_secret
REFRESH_TOKEN_EXPIRES_IN=30d
RESET_TOKEN_PRIVATE_KEY=your_strong_random_32char_hex_secret
RESET_TOKEN_EXPIRES_IN=1h
VERIFY_TOKEN_PRIVATE_KEY=your_strong_random_32char_hex_secret
VERIFY_TOKEN_EXPIRES_IN=1d
BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
